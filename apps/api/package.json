{
  "name": "@mataprm/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint src test prisma/*.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "seed": "prisma db seed",
    "seed:verify": "tsx --env-file=.env prisma/verify-seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@mataprm/shared": "workspace:*",
    "@prisma/client": "6.19.0",
    "fastify": "^5.6.0"
  },
  "devDependencies": {
    "prisma": "6.19.0",
    "tsx": "^4.20.0"
  }
}
